{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "whatsapp-bridge",
      "runtimeExecutable": "node",
      "runtimeArgs": ["bridge.js"],
      "cwd": "whatsapp_qr_bridge",
      "port": 3001
    }
  ]
}
