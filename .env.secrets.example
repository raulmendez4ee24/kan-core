DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kan_core
MASTER_KEY=replace_with_fernet_key

OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me
BRAVE_SEARCH_API_KEY=replace_me
TAVILY_API_KEY=replace_me
HUMANIZER_ENABLED=true
HUMANIZER_MODE=multiagent
HUMANIZER_MODEL=gpt-4o-mini
HUMANIZER_MIN_LEN=12

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_SECRET_TOKEN=replace_me

NGROK_AUTHTOKEN=replace_me
KAN_CLIENT_ID=replace_me
KAN_CLIENT_TOKEN=replace_me
CLIENT_TOKENS_JSON={"replace-client-id":"replace-client-token"}

N8N_API_KEY=replace_me
DESKTOP_AGENT_CLIENT_TOKEN=replace_me

# Google OAuth (Sheets / APIs) — Client ID + Secret para flujo OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Google Sheets Service Account (JSON completo en una línea, o usar GOOGLE_APPLICATION_CREDENTIALS con ruta a archivo)
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/...","universe_domain":"googleapis.com"}

# Cold Email Ops
COLD_EMAIL_SPREADSHEET_ID=replace_with_your_spreadsheet_id
ENABLE_COLD_EMAIL_OPS=true

ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me
META_ACCESS_TOKEN=replace_me
META_ADS_ACCESS_TOKEN=replace_me
META_AD_ACCOUNT_ID=act_123456789012345
GOOGLE_API_KEY=replace_me
