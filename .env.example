LOG_LEVEL=INFO
AUTO_CREATE_DB=false
RUN_DB_MIGRATIONS=false
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
HUMANIZER_ENABLED=true
HUMANIZER_MODE=multiagent
HUMANIZER_MODEL=gpt-4o-mini
HUMANIZER_MIN_LEN=12
ENABLE_TELEGRAM_REPLY=true
TELEGRAM_MODE=polling
ENABLE_NGROK_STATIC_DOMAIN=true
NGROK_STATIC_DOMAIN=your-subdomain.ngrok-free.app
ENABLE_TELEGRAM_WEBHOOK_SETUP=true
TELEGRAM_WEBHOOK_URL=https://your-subdomain.ngrok-free.app/webhooks/telegram
TELEGRAM_CHAT_CLIENT_MAP_JSON='{"*":"00000000-0000-0000-0000-000000000000"}'
KAN_BASE_URL=http://127.0.0.1:8000
STRICT_ROUTE_REGISTRY=false
RUNNER_MODE=local
# Runner auth for /desktop-agent/ws (remote mode)
CLIENT_ID=00000000-0000-0000-0000-000000000000
RUNNER_TOKEN=change-me
